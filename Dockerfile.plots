FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    MPLBACKEND=Agg

RUN pip install --no-cache-dir \
    jupyter==1.1.1 \
    nbconvert==7.16.6 \
    pandas==2.2.3 \
    matplotlib==3.9.4 \
    seaborn==0.13.2

WORKDIR /workspace

# Gera PNGs em metrics/plots/ a partir dos CSV
CMD ["python3", "-m", "jupyter", "nbconvert", "--execute", "notebooks/gerar_graficos.ipynb", \
     "--to", "notebook", "--output", "gerar_graficos_executado.ipynb", \
     "--output-dir", "notebooks", "--ExecutePreprocessor.timeout=120"]
