flowchart TB
  subgraph doc [Documentação e roteiros]
    usuario[Aluno / Professor]
    readme[README.md]
    labs[labs/ Lab 1–3]
    docs[docs/ + docs/aula/]
    topologias[topologies/]
    metricasDoc[metrics/README.md]
  end

  subgraph repo [Repositório redes-ufam]
    runsh[run.sh]
    dockerfile[Dockerfile]
    dockerfilePlots[Dockerfile.plots]
    entrypoint[docker-entrypoint.sh]
    scripts[scripts/]
    notebook[notebooks/gerar_graficos.ipynb]
  end

  subgraph docker [Docker Engine]
    container[mininet-lab]
    containerPlots[mininet-lab-plots]
  end

  subgraph runtime [Ambiente de laboratório]
    ovs[Open vSwitch]
    mininet[Mininet CLI / topologias]
    coletaLab[collect-metrics\nLabs 1–2]
    coletaRoute[collect-metrics-routing\nLab 3]
  end

  subgraph artifacts [Artefatos gerados]
    jsonOut["metrics/runs/\nrun_*.json\nrouting_run_*.json"]
    jsonCsv[json_runs_to_csv.py]
    csvOut["metrics/runs/\nlabs_1_2_runs.csv\nlab3_runs.csv"]
    pngOut["metrics/plots/\n*.png"]
  end

